<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_line_delivery_date" model="ir.ui.view">
        <field name="name">sale.order.line.delivery.date</field>
        <field name="model">sale.order</field>
        <field name="type">form</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']//list//field[@name='price_unit']" position="after">
                <field name="product_delivery_date"/>
            </xpath>
        </field>
    </record>
</odoo>
