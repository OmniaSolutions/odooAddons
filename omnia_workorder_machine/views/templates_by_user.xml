<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="by_user" name="Workorder by User">
        <head>
            <link rel="stylesheet" href="/omnia_workorder_machine/static/src/css/workorder_by_user.css"/>
            <script type="text/javascript" src="/omnia_workorder_machine/static/src/js/workorder_by_user.js"></script>
        </head>
        <body>
	        <div class="main_div">
	            <div class="wo_header">
	                <div class="wo_header_main">
	                    <h1 class="main_title">Register WorkOrder Activity</h1>
	                    <div class="wo_header_fields">
	                        <div class="wo_field_group" t-if="hide_user != True">
	                            <label id="td_user_id" for="input_user_id">User Id</label>
	                            <input id="input_user_id" type="number" class="user_id" placeholder="Enter user id"/>
	                        </div>
	                        <div class="wo_field_group" t-if="hide_user == True">
	                            <label id="td_employee_id" for="input_employee_id">Employee Id</label>
	                            <input id="input_employee_id" type="number" class="employee_id" placeholder="Enter employee id"/>
	                        </div>
	                        <div class="wo_field_group">
	                            <label id="td_user_name">User Name</label>
	                            <span id="user_name" class="wo_user_name">—</span>
	                        </div>
	                    </div>
	                </div>
	                <div class="wo_header_side">
	                    <img id="waiting_clock" class="wo_clock" src="/omnia_workorder_machine/static/src/images/clock.gif"/>
	                    <div id="customer_image">
	                        <img src="/web/binary/company_logo" onerror="this.onerror=null;this.src='/omnia_workorder_machine/static/src/images/logo_placeholder.svg';"/>
	                    </div>
	                </div>
	            </div>
	            <div class="wo_table_wrapper">
	            <table class="main_table" id="to_replace">
	               <thead>
	                  <tr>
                          <th class="header_table">Select</th>
		                <th id="by_user_h_1" class="header_table">ID</th>
		                <th id="by_user_h_2" class="header_table">Date Planned</th>
		                <th id="by_user_h_3" class="header_table">Internal<br/>Reference</th>
		                <th id="by_user_h_4" class="header_table">Product<br/>Name</th>
		                <th id="by_user_h_5" class="header_table">Work Order<br/>Name</th>
		                <th id="by_user_h_6" class="header_table">Production<br/>Name</th>
		                <th id="by_user_h_7" class="header_table">N To<br/>Do</th>
		                <th id="by_user_h_8" class="header_table">N Produced</th>
		                <th id="by_user_h_9" class="header_table">Scrap</th>
		                <th id="by_user_h_10" class="header_table">Operation</th>
		                <th id="by_user_h_11" class="header_table">Description</th>
		                <th id="by_user_h_12" class="header_table">Work Order<br/>State</th>
		                <th id="by_user_h_13" class="header_table">User<br/>Working</th>
		                <th id="label" class="header_table" >Label</th>
		                <th id="by_user_h_15" class="header_table">Worksheet</th>
		            </tr>
	               </thead>
	               <tbody id="workorder_body">
	               </tbody>
	            </table>
	            </div>
	        </div>
	    </body>
    </template>

	<template id="template_workorder_machine_table" name="Workorder Table">
	        <t t-foreach="wo_lines" t-as="line">
	               <tr class="content_line">
                   <td>
                        <input type="checkbox" class="select_row"/>
                    </td>
	                <td id="td_user_h_1" class="table_value wo_id"><t t-out="line[0]"/></td>
	                <td id="td_user_h_2" class="table_value"><t t-out="line[8]"/></td>
	                <td id="td_user_h_3" class="table_value internal_ref"><t t-out="line[2]"/></td>
	                <td id="td_user_h_4" class="table_value product_name_cell"><span class="truncate-cell" t-att-title="line[1]"><t t-out="line[1]"/></span></td>
	                <td id="td_user_h_5" class="table_value"><t t-out="line[3]"/></td>
	                <td id="td_user_h_6" class="table_value"><t t-out="line[4]"/></td>
	                <td id="td_user_h_7" class="table_value n_pieces_to_produce">
                        <t t-set="qty_str" t-value="line[7]"/>
                        <t t-set="parts" t-value="qty_str.split(' / ')"/>
                        <t t-set="done" t-value="parts[0]"/>
                        <t t-set="right" t-value="parts[1] if len(parts) > 1 else ''"/>
                        <t t-set="right_parts" t-value="right.split(' ')"/>
                        <t t-set="total" t-value="right_parts[0]"/>
                        <t t-set="unit" t-value="' '.join(right_parts[1:]) if len(right_parts) > 1 else ''"/>
                        <t t-set="remaining" t-value="float(total) - float(done)"/>
                        <span style="color:#34B333;font-weight:bold;"><t t-out="done"/></span>
                        /
                        <span><t t-out="total"/> <t t-out="unit"/></span>
                    </td>
	                <td id="td_user_h_8" class="table_value"><input id="input_n_pieces" type="number" name="n_pieces" class="n_pieces" step="0.001" value="0" /></td>
	                <td id="td_user_h_9" class="table_value"><input id="input_n_scrap" type="number" name="n_scrap" class="n_scrap" step="0.001" value="0" /></td>
	                <td id="td_user_h_10" class="table_value">
	                	<div style="display: block ruby;">
	                		<input class="start_work" type='button' value='Start'/>
	                		<input class="pause_work" type='button' value='Pause'/>
	                		<input class="resume_work" type='button' value='Resume'/>
	                		<input class="stop_work" type='button' value='Record'/>
                            <div id="woPopup" class="wo-modal">
                                <div class="wo-modal-content">
                                    <h2>Entry for selected workorder</h2>
                                    <hr/>
                                    <table class="wo-table">
                                        <thead>
                                            <tr>
                                                <th>Workorders</th>
                                                <th>Product Name</th>
                                                <th class="n_items_col">N. Items</th>
                                                <th>Done</th>
                                                <th>Remaining</th>
                                                <th>Total</th>
                                                <th>Duration</th>
                                                <th>Scrap</th>
                                            </tr>
                                        </thead>
                                        <tbody id="wo_dynamic_rows"/>
                                    </table>
                                    <label class="section-title">Total Time</label>
                                    <input type="text" class="wo-input" id="total_time" placeholder="Enter total time"/>
                                    <button class="wo-submit">Submit</button>
                                    <button class="wo-cancel" id="closeBtn">Cancel</button>
                                </div>
                            </div>
	                	</div>
	                </td>
	                <td id="td_user_h_11" class="table_value">
	                	<input type="text"
	                	       class="description_input"
	                	       name="description"
	                	       placeholder="Add Note..."
	                	       t-att-value="line[5] or ''"
	                	       t-att-data-wo-id="line[0]"/>
	                </td>
	                <td id="td_user_h_12" class="table_value wo_state" onchange="state_changed(this)"><t t-out="line[6]"/></td>
                     <td id="td_user_h_13" class="table_value">
                         <t t-if="line[9]=='False'">
                             <span class="wo-badge wo-badge-danger">Not Working</span>
                         </t>
	                    <t t-if="line[9]=='True'">
	                       <span class="wo-badge wo-badge-success">Working</span>
	                    </t>
                     </td>
                    <td id="td_user_h_14" class="table_value wo_isuserworking" style="display:none"><t t-out="line[9]"/></td>
	                <td id="by_user_r_lable" class="table_value"><input class="print_label" type='button' value='Print'/></td>
	                <td id="td_user_h_15" class="table_value"><a class="wo-view-btn" t-att-href="line[10]" target="_blank">View</a></td>
	            </tr>
	       </t>
	</template>
</odoo>
