<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ai_report_agent_wizard_form" model="ir.ui.view">
        <field name="name">ai.report.agent.wizard.form</field>
        <field name="model">ai.report.agent.wizard</field>
        <field name="arch" type="xml">
            <form string="Report Preview">
                <field name="res_model" invisible="1"/>
                <field name="res_ids" invisible="1"/>
                <div class="alert alert-warning" role="alert" invisible="not verification_summary">
                    <strong>AI accuracy check found possible issues -- review before printing:</strong>
                    <field name="verification_summary" nolabel="1" readonly="1"/>
                </div>
                <field name="preview_html" readonly="1" nolabel="1"/>
                <footer>
                    <button name="action_print" type="object" string="Print"
                            class="btn-primary" icon="fa-print"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
